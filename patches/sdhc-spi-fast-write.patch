+/* CMD6 changes card timing without changing its SPI protocol or file format.
+ * Only write blocks use the higher clock: nRF5340 receive remains <= 16 MHz.
+ */
+static int sdhc_spi_enable_fast_write(const struct device *dev)
+{
+	const struct sdhc_spi_config *config = dev->config;
+	struct sdhc_spi_data *dev_data = dev->data;
+	uint8_t status[64];
+	struct sdhc_command cmd = {
+		.opcode = SD_SWITCH,
+		.arg = 0x00fffff1U,
+		.response_type = SD_SPI_RSP_TYPE_R1,
+		.timeout_ms = CONFIG_SD_CMD_TIMEOUT,
+	};
+	struct sdhc_data data = {
+		.block_size = sizeof(status),
+		.blocks = 1,
+		.data = status,
+		.timeout_ms = CONFIG_SD_DATA_TIMEOUT,
+	};
+	int ret;
+
+	if (dev_data->speed_checked || config->spi_max_freq < 32000000U ||
+	    dev_data->spi_cfg->frequency <= 16000000U ||
+	    nrf_clock_hfclk_div_get(NRF_CLOCK) != NRF_CLOCK_HFCLK_DIV_1) {
+		return 0;
+	}
+
+	/* Check support, then request high-speed timing, both at the old clock. */
+	for (int mode = 0; mode < 2; mode++) {
+		cmd.arg = 0x00fffff1U | ((uint32_t)mode << 31);
+		ret = sdhc_spi_send_cmd(dev, &cmd, true);
+		if (ret == -EINVAL && (cmd.response[0] & SD_SPI_R1ILLEGAL_CMD_ERR)) {
+			dev_data->speed_checked = true;
+			return 0;
+		}
+		if (ret) {
+			return ret;
+		}
+		ret = sdhc_spi_read_data(dev, &data);
+		if (ret) {
+			return ret;
+		}
+		if (!(status[13] & BIT(1)) ||
+		    (status[17] == 1 && (status[29] & BIT(1)))) {
+			dev_data->speed_checked = true;
+			return 0;
+		}
+	}
+
+	dev_data->speed_checked = true;
+	if ((status[16] & 0x0f) == 1) {
+		dev_data->write_frequency = 32000000U;
+		LOG_INF("SD high-speed writes enabled: 32 MHz TX, 16 MHz RX");
+	}
+	return 0;
+}
